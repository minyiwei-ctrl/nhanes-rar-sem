TITLE:
    M1 depression, secondary age-unstratified model: IV -> (BA_ADV, SII_LOG) -> PHQ9,
    all adults aged 20 and over. Every regression adjusts for AGE SEX BMI EDU WEAR_T SLEEP_H; residual
    covariance BA_ADV WITH SII_LOG. TYPE = COMPLEX (WT4YR, STRATUM, PSU), MLR,
    missing dependent variables by FIML, delta-method intervals (CINTERVAL),
    TECH3 retained.

DATA:
    FILE = ../../data/mplus/nhanes_sem.dat;

VARIABLE:
    NAMES =
        
        SEQN IV RA IS BA_ADV SII_LOG NLR_LOG OBJ_MVPA PHQ9
        COG_Z MEM_Z FLUEN_Z SPEED_Z AGE SEX BMI EDU WEAR_T
        SLEEP_H VOLUME AGE60 IV_AGE IS_AGE RA_AGE IV_Q WT4YR STRATUM
        PSU ADULT20;

    USEVARIABLES =
        IV BA_ADV SII_LOG PHQ9
        AGE SEX BMI EDU WEAR_T SLEEP_H;

    MISSING = ALL(-9999);


    SUBPOPULATION = ADULT20 EQ 1;
    IDVARIABLE = SEQN;

    STRATIFICATION = STRATUM;
    CLUSTER        = PSU;
    WEIGHT         = WT4YR;

ANALYSIS:
    TYPE        = COMPLEX;
    ESTIMATOR   = MLR;
    INFORMATION = OBSERVED;

MODEL:
    ! a-paths: IV -> each mediator, adjusted for covariates
    BA_ADV  ON IV (a1)
               AGE SEX BMI EDU WEAR_T SLEEP_H;

    SII_LOG ON IV (a2)
               AGE SEX BMI EDU WEAR_T SLEEP_H;

    ! Outcome equation: direct path + b-paths + covariates
    PHQ9 ON IV       (cp)
            BA_ADV   (b1)
            SII_LOG  (b2)
            AGE SEX BMI EDU WEAR_T SLEEP_H;

    ! Residual covariance between the two mediators
    BA_ADV WITH SII_LOG;

MODEL INDIRECT:
    PHQ9 IND IV;
    PHQ9 IND BA_ADV IV;
    PHQ9 IND SII_LOG IV;

MODEL CONSTRAINT:
    ! prop_BA and prop_SII divide an indirect effect by the total effect. That
    ! ratio is only interpretable when the total effect is distinguishable from
    ! zero. When it is not, the denominator is near zero, the ratio is unstable
    ! and its confidence interval is uninformative -- in the first corrected run
    ! the cognition model returned prop_BA = 0.411 with a 95% CI of 0.007 to
    ! 0.815 against a total effect of p = 0.062, and the depression model
    ! returned a NEGATIVE proportion against a null total effect.
    ! These quantities are computed here but must NOT be reported unless the
    ! total effect is significant. Script 10 enforces that rule.
    ! A significant indirect effect with a null total effect is not a
    ! contradiction and remains reportable on its own (Zhao, Lynch & Chen 2010;
    ! Rucker et al. 2011); it is only the PROPORTION that breaks down.
    NEW(ind_BA ind_SII total_ind prop_BA prop_SII total);
    ind_BA    = a1 * b1;
    ind_SII   = a2 * b2;
    total_ind = ind_BA + ind_SII;
    total     = cp + total_ind;
    prop_BA   = ind_BA  / total;
    prop_SII  = ind_SII / total;

OUTPUT:
    ! CINTERVAL yields DELTA-METHOD confidence intervals for the indirect
    ! effects. The delta method assumes the product a*b is normally distributed,
    ! which is known to be poor for mediation, especially in the tails.
    ! Bootstrap is unavailable here: Mplus does not permit BOOTSTRAP with
    ! TYPE = COMPLEX and sampling weights. TECH3 is saved below precisely so
    ! that Monte Carlo confidence intervals can be constructed post hoc from the
    ! parameter estimates and their asymptotic covariance matrix, which is the
    ! standard remedy (MacKinnon, Lockwood & Williams 2004; Preacher & Selig
    ! 2012). Report Monte Carlo intervals for the indirect effects; the delta
    ! intervals below are retained for comparison only.
OUTPUT:
    STDYX
    CINTERVAL
    TECH1
    TECH3
    SVALUES;

SAVEDATA:
    RESULTS = M1_depression_results.dat;
    TECH3   = M1_depression_tech3.dat;
