TITLE:
    Sensitivity S1 - depression dual-mediator SEM, KDM-BA tails trimmed

    Identical to M1_depression.inp except that participants beyond the 0.5th
    (11.04 years) or 99.5th (116.35 years) percentile of KDM-Biological Age
    are excluded via SUBPOPULATION (domain analysis -- all strata and PSUs
    stay in the variance estimation, which USEOBSERVATIONS would break).
    All other specification is unchanged.

DATA:
    FILE = ../../data/mplus/nhanes_sem_trimmed.dat;

VARIABLE:
    NAMES =
        SEQN IV RA IS BA_ADV SII_LOG NLR_LOG OBJ_MVPA PHQ9
        COG_Z MEM_Z FLUEN_Z SPEED_Z AGE SEX BMI EDU WEAR_T
        SLEEP_H VOLUME AGE60 IV_AGE IS_AGE RA_AGE IV_Q WT4YR STRATUM
        PSU ADULT20 KDMOUT;

    USEVARIABLES =
        IV BA_ADV SII_LOG PHQ9
        AGE SEX BMI EDU WEAR_T SLEEP_H;

    SUBPOPULATION = ADULT20 EQ 1 AND KDMOUT EQ 0;

    MISSING = ALL(-9999);
    IDVARIABLE = SEQN;
    STRATIFICATION = STRATUM;
    CLUSTER        = PSU;
    WEIGHT         = WT4YR;

ANALYSIS:
    TYPE        = COMPLEX;
    ESTIMATOR   = MLR;
    INFORMATION = OBSERVED;

MODEL:
    BA_ADV  ON IV (a1)
               AGE SEX BMI EDU WEAR_T SLEEP_H;
    SII_LOG ON IV (a2)
               AGE SEX BMI EDU WEAR_T SLEEP_H;
    PHQ9 ON IV       (cp)
            BA_ADV   (b1)
            SII_LOG  (b2)
            AGE SEX BMI EDU WEAR_T SLEEP_H;
    BA_ADV WITH SII_LOG;

MODEL INDIRECT:
    PHQ9 IND IV;
    PHQ9 IND BA_ADV IV;
    PHQ9 IND SII_LOG IV;

MODEL CONSTRAINT:
    NEW(ind_BA ind_SII total_ind total);
    ind_BA    = a1 * b1;
    ind_SII   = a2 * b2;
    total_ind = ind_BA + ind_SII;
    total     = cp + total_ind;

OUTPUT:
    STDYX CINTERVAL;
