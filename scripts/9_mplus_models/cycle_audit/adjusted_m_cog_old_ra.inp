TITLE:
    Cycle audit: adjusted; baseline m_cog_old_ra.
    RA -> (KDM-BA, log SII) -> COG, adults 60+

DATA:

    FILE = ../../../data/mplus/nhanes_sem_cycle.dat;

VARIABLE:
    NAMES =
        SEQN IV RA IS BA_ADV SII_LOG NLR_LOG
        OBJ_MVPA PHQ9 COG_Z MEM_Z FLUEN_Z SPEED_Z AGE
        SEX BMI EDU WEAR_T SLEEP_H VOLUME AGE60
        IV_AGE IS_AGE RA_AGE IV_Q WT4YR STRATUM PSU
        ADULT20 RA_N3 RA_N4 RA_N5 IV_N3 IV_N4 IV_N5
        RA_Q2 RA_Q3 RA_Q4 RA_Q5 IV_Q2 IV_Q3 IV_Q4
        IV_Q5 EDU2 EDU3 EDU4 EDU5 CYCLE2;

    USEVARIABLES =
        RA BA_ADV SII_LOG MEM_Z FLUEN_Z SPEED_Z AGE
        SEX BMI EDU WEAR_T SLEEP_H CYCLE2;

    MISSING = ALL(-9999);

    SUBPOPULATION = AGE60 EQ 1;

    IDVARIABLE = SEQN;

    STRATIFICATION = STRATUM;
    CLUSTER        = PSU;
    WEIGHT         = WT4YR;

ANALYSIS:
    TYPE        = COMPLEX;
    ESTIMATOR   = MLR;
    INFORMATION = OBSERVED;
    STARTS      = 20;

MODEL:
    COG BY MEM_Z* (l1)
           FLUEN_Z* (l2)
           SPEED_Z* (l3);
    COG@1;


    BA_ADV  ON RA (a1)
               AGE SEX BMI EDU WEAR_T SLEEP_H CYCLE2;

    SII_LOG ON RA (a2)
               AGE SEX BMI EDU WEAR_T SLEEP_H CYCLE2;

    COG ON RA (cp)
           BA_ADV  (b1)
           SII_LOG (b2)
           AGE SEX BMI EDU WEAR_T SLEEP_H CYCLE2;

    BA_ADV WITH SII_LOG;

MODEL INDIRECT:
    COG IND RA;
    COG IND BA_ADV RA;
    COG IND SII_LOG RA;

MODEL CONSTRAINT:
    NEW(ind_BA ind_SII total_ind prop_BA prop_SII total);
    l1 > 0;

    ind_BA    = a1 * b1;
    ind_SII   = a2 * b2;
    total_ind = ind_BA + ind_SII;
    total     = cp + total_ind;
    prop_BA   = ind_BA  / total;
    prop_SII  = ind_SII / total;

OUTPUT:
    STDYX CINTERVAL TECH1 TECH3 SVALUES;

SAVEDATA:
    RESULTS = adjusted_m_cog_old_ra_results.dat;
    TECH3   = adjusted_m_cog_old_ra_tech3.dat;
