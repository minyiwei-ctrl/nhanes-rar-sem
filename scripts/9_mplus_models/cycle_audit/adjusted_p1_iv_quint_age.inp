TITLE:
    Cycle audit: adjusted; baseline p1_iv_quint_age.
    P1 IV: quintile indicators with age interactions; MODEL TEST = the four Q-by-age terms zero (4 df)

DATA:

    FILE = ../../../data/mplus/nhanes_sem_cycle.dat;

VARIABLE:
    NAMES =
        SEQN IV RA IS BA_ADV SII_LOG NLR_LOG
        OBJ_MVPA PHQ9 COG_Z MEM_Z FLUEN_Z SPEED_Z AGE
        SEX BMI EDU WEAR_T SLEEP_H VOLUME AGE60
        IV_AGE IS_AGE RA_AGE IV_Q WT4YR STRATUM PSU
        ADULT20 RA_N3 RA_N4 RA_N5 IV_N3 IV_N4 IV_N5
        RA_Q2 RA_Q3 RA_Q4 RA_Q5 IV_Q2 IV_Q3 IV_Q4
        IV_Q5 EDU2 EDU3 EDU4 EDU5 CYCLE2;

    USEVARIABLES =
        IV_Q2 IV_Q3 IV_Q4 IV_Q5 AGE BA_ADV SEX
        BMI EDU WEAR_T SLEEP_H CYCLE2 IVQ2AGE IVQ3AGE
        IVQ4AGE IVQ5AGE;

    MISSING = ALL(-9999);

    SUBPOPULATION = ADULT20 EQ 1;

    IDVARIABLE = SEQN;

    STRATIFICATION = STRATUM;
    CLUSTER        = PSU;
    WEIGHT         = WT4YR;

DEFINE:
    IVQ2AGE = IV_Q2*AGE;
    IVQ3AGE = IV_Q3*AGE;
    IVQ4AGE = IV_Q4*AGE;
    IVQ5AGE = IV_Q5*AGE;

ANALYSIS:
    TYPE        = COMPLEX;
    ESTIMATOR   = MLR;
    INFORMATION = OBSERVED;

MODEL:
    BA_ADV ON IV_Q2 IV_Q3 IV_Q4 IV_Q5
              AGE (g_age)
              IVQ2AGE (q2)
              IVQ3AGE (q3)
              IVQ4AGE (q4)
              IVQ5AGE (q5)
              SEX BMI EDU WEAR_T SLEEP_H CYCLE2;

MODEL TEST:
    q2 = 0;
    q3 = 0;
    q4 = 0;
    q5 = 0;

OUTPUT:
    STDYX CINTERVAL TECH1;
