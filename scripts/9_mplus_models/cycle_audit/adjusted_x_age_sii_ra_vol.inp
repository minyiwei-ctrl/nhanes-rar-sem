TITLE:
    Cycle audit: adjusted; baseline x_age_sii_ra_vol.
    RA x age on the a2 path (log SII), adults 20+, volume-adjusted

DATA:

    FILE = ../../../data/mplus/nhanes_sem_cycle.dat;

VARIABLE:
    NAMES =
        SEQN IV RA IS BA_ADV SII_LOG NLR_LOG
        OBJ_MVPA PHQ9 COG_Z MEM_Z FLUEN_Z SPEED_Z AGE
        SEX BMI EDU WEAR_T SLEEP_H VOLUME AGE60
        IV_AGE IS_AGE RA_AGE IV_Q WT4YR STRATUM PSU
        ADULT20 RA_N3 RA_N4 RA_N5 IV_N3 IV_N4 IV_N5
        RA_Q2 RA_Q3 RA_Q4 RA_Q5 IV_Q2 IV_Q3 IV_Q4
        IV_Q5 EDU2 EDU3 EDU4 EDU5 CYCLE2;

    USEVARIABLES =
        RA RA_AGE SII_LOG AGE SEX BMI EDU
        WEAR_T SLEEP_H VOLUME CYCLE2;

    MISSING = ALL(-9999);


    SUBPOPULATION = ADULT20 EQ 1;
    IDVARIABLE = SEQN;

    STRATIFICATION = STRATUM;
    CLUSTER        = PSU;
    WEIGHT         = WT4YR;

ANALYSIS:
    TYPE        = COMPLEX;
    ESTIMATOR   = MLR;
    INFORMATION = OBSERVED;

MODEL:
    SII_LOG ON RA      (a_main)
               RA_AGE  (a_int)
               AGE SEX BMI EDU WEAR_T SLEEP_H VOLUME CYCLE2;

MODEL CONSTRAINT:
    ! simple slopes at +/- 1 SD of age, and at the mean
    NEW(slope_lo slope_mid slope_hi);
    slope_lo  = a_main - a_int;
    slope_mid = a_main;
    slope_hi  = a_main + a_int;

OUTPUT:
    STDYX CINTERVAL TECH1 TECH3;

SAVEDATA:
    RESULTS = adjusted_x_age_sii_ra_vol_results.dat;
