TITLE: Cycle difference in RA to BA_ADV, young.
DATA:
    FILE = ../../../data/mplus/nhanes_sem_cycle.dat;
VARIABLE:
    NAMES =
        SEQN IV RA IS BA_ADV SII_LOG NLR_LOG
        OBJ_MVPA PHQ9 COG_Z MEM_Z FLUEN_Z SPEED_Z AGE
        SEX BMI EDU WEAR_T SLEEP_H VOLUME AGE60
        IV_AGE IS_AGE RA_AGE IV_Q WT4YR STRATUM PSU
        ADULT20 RA_N3 RA_N4 RA_N5 IV_N3 IV_N4 IV_N5
        RA_Q2 RA_Q3 RA_Q4 RA_Q5 IV_Q2 IV_Q3 IV_Q4
        IV_Q5 EDU2 EDU3 EDU4 EDU5 CYCLE2;
    USEVARIABLES = BA_ADV RA AGE SEX BMI EDU WEAR_T SLEEP_H
        CYCLE2 C0 C1 C2 C3 C4 C5 C6;
    MISSING = ALL(-9999);
    SUBPOPULATION = ADULT20 EQ 1 AND AGE60 EQ 0;
    IDVARIABLE = SEQN;
    STRATIFICATION = STRATUM;
    CLUSTER = PSU;
    WEIGHT = WT4YR;
DEFINE:
    C0 = CYCLE2 * RA;
    C1 = CYCLE2 * AGE;
    C2 = CYCLE2 * SEX;
    C3 = CYCLE2 * BMI;
    C4 = CYCLE2 * EDU;
    C5 = CYCLE2 * WEAR_T;
    C6 = CYCLE2 * SLEEP_H;
ANALYSIS:
    TYPE = COMPLEX;
    ESTIMATOR = MLR;
    INFORMATION = OBSERVED;
MODEL:
    BA_ADV ON RA (bG)
        C0 (delta)
        AGE SEX BMI EDU WEAR_T SLEEP_H CYCLE2 C1 C2 C3 C4 C5 C6;
MODEL CONSTRAINT:
    NEW(bH);
    bH = bG + delta;
MODEL TEST:
    delta = 0;
OUTPUT:
    STDYX CINTERVAL TECH1 TECH3;
